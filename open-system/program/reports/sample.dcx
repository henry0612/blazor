  <DocCreator>
    <FileOutJob jobName="sample" fileName="sample">
      <Document type="BINARY" />
    </FileOutJob>
  </DocCreator>
  <MappingTool>
    <Property name="FieldOrder">
      <Value>
        <Property name="sample.cfx" value="Text1,Text2" />
      </Value>
    </Property>
  </MappingTool>
  <RecordSet name="サンプルデータ" type="CSV" virtualStartIndex="10000" repeat="1">
    <Property name="Delimiter" value="," />
    <Property name="Header" value="True" />
    <Property name="BlankLine" value="False" />
    <Source valueAs="DATA" valueType="TEXT" value="Id,CompanyCode,CompanyNameKana" />
  </RecordSet>
  <Report name="サンプルストリームレポート" recordSet="サンプルデータ">
