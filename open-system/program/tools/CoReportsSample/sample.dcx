<?xml version="1.0" encoding="utf-8"?>
<DocCreatorConf version="5.0" xmlns="http://schema.hos.co.jp/dcx/5.0/">
  <DocCreator>
    <FileOutJob jobName="sample" fileName="sample">
      <Document type="BINARY" />
    </FileOutJob>
  </DocCreator>
  <RecordSet name="サンプルデータ" type="CSV">
    <Source valueAs="FILE" value="sample.csv" />
  </RecordSet>
  <Report name="サンプルレポート" recordSet="サンプルデータ">
    <Form name="sample.cfx">
      <Layout valueAs="FILE">sample.cfx</Layout>
      <Field name="Text1">0</Field>
      <Field valueType="TEMPLATE" name="Text2">$U{Text2}</Field>
    </Form>
  </Report>
</DocCreatorConf>
