@page "/bank/master"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.QuickGrid
@using UnifiedAccount.Application.DTOs
@using UnifiedAccount.Application.Services

@inject IBankBranchService BankBranchService
@inject ILogger<BankMaster> Logger
@inject NavigationManager Navigation

<PageTitle>銀行マスタ異動</PageTitle>

<h2 class="shared-page-header__title" style="margin-bottom:14px;">銀行マスタ異動</h2>

@*検索条件*@
<div class="mock-card" style="margin-bottom:8px;">
    <div style="font-size:14px; font-weight:bold; color:var(--muted); margin-bottom:10px;">
        検索条件
    </div>

    <div style="display:flex; align-items:flex-end; gap:10px; flex-wrap:wrap;">        
        <div>
            <div class="shared-form-field__label">金融機関コード（4桁）</div>
            <input type="text"
                   class="form-control form-control-sm"
                   maxlength="4"
                   style="width:130px;"
                   @bind="_searchBankCode"
                   @onkeyup="@(async e => { if (e.Key == "Enter") await OnSearchClickedAsync(); })" />
        </div>

        <div>
            <div class="shared-form-field__label">支店コード（3桁）</div>
            <input type="text"
                   class="form-control form-control-sm"
                   maxlength="3"
                   style="width:100px;"
                   @bind="_searchBranchCode"
                   @onkeyup="@(async e => { if (e.Key == "Enter") await OnSearchClickedAsync(); })" />
        </div>

        <button type="button"
                class="mock-btn"
                @onclick="OnSearchClickedAsync"
                disabled="@_isLoading"
                title="検索"
                style="align-self:flex-end;text-align:center;">
            検索
        </button>

        <button type="button"
                class="mock-btn"
                @onclick="ClearConditions"
                style="align-self:flex-end;text-align:center;">
            条件クリア
        </button>

        <button type="button"
                class="mock-btn mock-btn--primary"
                @onclick="StartAdd"
                disabled="@_isCheckingNew"
                style="align-self:flex-end;text-align:center;">
            ＋新規追加
        </button>
    </div>
</div>

@* メッセージエリア *@
<MessageArea ErrorMessage="@_errorMessage"
             SuccessMessage="@_successMessage"
             OnErrorCleared="@(() => _errorMessage = null)"
             OnSuccessCleared="@(() => _successMessage = null)" />

@if (_loadErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">
        @_loadErrorMessage
    </div>
}    

@if (_loadErrorMessage is null)
{
    <div class="mock-card" style="padding:0; overflow:hidden;@(_hasSearched ? "" : "display:none;")">
        @*検索結果件数*@
        <div style="margin-top:10px;margin-left:12px;margin-bottom:10px;
                    font-size:13px; color:var(--muted);">
            検索結果: @(_totalCount)件
        </div>

        @*仕切り線*@
        <hr style="margin:0;border:none;border-top:1px solid #aaa;" />
        
        @*一覧*@
        <div class="table-responsive">
            <QuickGrid TGridItem="BankBranchRow"
                        ItemsProvider="LoadItemsAsync"
                        Pagination="_pagination"
                        @ref="_grid"
                        Virtualize="false"
                        Class="mock-table">

                <PropertyColumn Property="item => item.BankCode"
                                Title="金融機関コード" />

                <PropertyColumn Property="item => item.BankNameKanji"
                                Title="金融機関名" />

                <PropertyColumn Property="item => item.BankNameKana"
                                Title="金融機関カナ名" />

                <PropertyColumn Property="item => item.BranchCode"
                                Title="支店コード" />

                <PropertyColumn Property="item => item.BranchNameKanji"
                                Title="支店名" />

                <PropertyColumn Property="item => item.BranchNameKana"
                                Title="支店カナ名" />
                <TemplateColumn Title="操作" Class="text-center">
                    <a href="@GetDetailUrl(context)"
                        aria-label="@($"編集: {context.BankCode} / {context.BranchCode}")"
                        class="code-category-list-link">
                        編集
                    </a>
                </TemplateColumn>
            </QuickGrid>
        </div>
    </div>

    <div style="margin-top:12px;@(_hasSearched ? "" : "display:none;")">
        <Paginator State="_pagination" />
    </div>
}

<style>
    /* データ行の高さ */
    .mock-table tbody td {
        padding: 10px 8px !important;
    }

    /* 空白行の罫線を消す */
    .mock-table tbody tr:has(td:first-child:empty) {
        display: none;
    }
        
</style>
