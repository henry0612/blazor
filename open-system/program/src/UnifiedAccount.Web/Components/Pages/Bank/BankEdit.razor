@page "/bank/edit/new"
@page "/bank/edit/{BankCode}/{BranchCode}"
@rendermode InteractiveServer

@* 223 F-ONL-007 v1.4: 画面固有の [Authorize] は付与しない。FallbackPolicy（認証必須）だけに従う。 *@

<PageTitle>銀行マスタ異動編集</PageTitle>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
    <h2 class="shared-page-header__title" style="margin:0;">銀行マスタ異動編集</h2>
    <button type="button" class="mock-btn" @onclick="GoBack">一覧へ戻る</button>
</div>

@if (!_isLoaded)
{
    @* <div style="color:var(--muted); padding:24px 0;">読み込み中…</div> *@
}
else
{
    <div class="mock-card">

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px 20px;">
            @* 行1: 金融機関コード / 金融機関名 / 金融機関カナ名 *@
            <div>
                <div class="shared-form-field__label">金融機関コード</div>
                <input type="text" class="form-control form-control-sm"
                       value="@_editBankCode" readonly
                       style="background:var(--bg); color:var(--muted);" />
            </div>
            <div>
                <div class="shared-form-field__label">金融機関名</div>
                <input type="text" class="form-control form-control-sm" maxlength="15"
                       @bind="_bankName" />
            </div>
            <div>
                <div class="shared-form-field__label">
                    金融機関カナ名（半角）
                </div>
                 <input type="text"
                       class="form-control form-control-sm @(_bankNameKanaError is not null ? "is-invalid" : "")"
                       maxlength="20"
                       @bind="_bankNameKana"
                       @oninput="() => _bankNameKanaError = null" /> 
                
                @if (_bankNameKanaError is not null)
                {
                    <div style="font-size:11px; color:var(--danger); margin-top:2px;">@_bankNameKanaError</div>
                }
            </div>

            @* 行2: 支店コード / 支店名 / 支店カナ名 *@
            <div>
                <div class="shared-form-field__label">支店コード</div>
                <input type="text" class="form-control form-control-sm"
                       value="@_editBranchCode" readonly
                       style="background:var(--bg); color:var(--muted);" />
            </div>
            <div>
                <div class="shared-form-field__label">支店名</div>
                <input type="text" class="form-control form-control-sm" maxlength="15"
                       @bind="_branchName" />
            </div>
            <div>
                <div class="shared-form-field__label">
                    支店カナ名（半角）
                </div>
                <input type="text"
                       class="form-control form-control-sm @(_branchNameKanaError is not null ? "is-invalid" : "")"
                       maxlength="20"
                       @bind="_branchNameKana"
                       @oninput="() => _branchNameKanaError = null" />
                @if (_branchNameKanaError is not null)
                {
                    <div style="font-size:11px; color:var(--danger); margin-top:2px;">@_branchNameKanaError</div>
                }
            </div>

        </div>

        @* ボタン行 *@
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:20px;">
            <div style="display:flex; gap:8px; align-items:center;">
                <button type="button" class="mock-btn mock-btn--primary" @onclick="SaveAsync" disabled="@_isSaving">
                    保存
                </button>
                <button type="button" class="mock-btn" @onclick="Cancel">キャンセル</button>
            </div>
            @if (!_isNewRow)
            {
                <button type="button" class="mock-btn"
                        style="background:var(--danger); color:var(--surface); border-color:var(--danger);"
                        @onclick="StartDelete">
                    削除
                </button>
            }
        </div>

        @* メッセージエリア *@
        <div style="margin-top:12px;">
            <MessageArea ErrorMessage="@_errorMessage" SuccessMessage="@_successMessage"
                         OnErrorCleared="@(() => _errorMessage = null)"
                         OnSuccessCleared="@(() => _successMessage = null)" />
        </div>

    </div>
}

<ConfirmDialog IsVisible="@_showDeleteConfirm"
               Title="削除確認"
               Message="@($"金融機関コード {_editBankCode} / 支店コード {_editBranchCode} を削除します。よろしいですか？")"
               ConfirmText="削除"
               ConfirmButtonClass="danger"
               OnConfirm="DeleteAsync"
               OnCancel="@(() => _showDeleteConfirm = false)" />
                
<ConfirmDialog IsVisible="@_showLeaveConfirm"
               Title="確認"
               Message="変更内容が保存されていません。一覧へ戻りますか？"
               ConfirmText="戻る"
               OnConfirm="GoBackConfirmed"
               OnCancel="@(() => _showLeaveConfirm = false)" />

