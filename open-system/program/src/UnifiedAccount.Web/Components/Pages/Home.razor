@page "/"
@rendermode InteractiveServer
<PageTitle>統一口座システム</PageTitle>

<div class="home-dashboard fade-in">
    <div class="home-calendar-section">
        <PageHeader Title="本日以降1週間のカレンダー">
            <Actions>
                <div class="home-dashboard__controls">
                    <button type="button" class="mock-btn" @onclick="() => ShiftBaseDate(-7)">前週</button>
                    <button type="button" class="mock-btn" @onclick="() => ShiftBaseDate(-1)">前日</button>
                    <span class="small text-muted mono">@CalendarPeriodLabel</span>
                    <button type="button" class="mock-btn" @onclick="() => ShiftBaseDate(1)">翌日</button>
                    <button type="button" class="mock-btn" @onclick="() => ShiftBaseDate(7)">翌週</button>
                </div>
            </Actions>
        </PageHeader>

        <div class="mock-card home-calendar-card">
            <table class="mock-table">
                <thead>
                    <tr>
                        <th>日付</th>
                        <th>曜日</th>
                        <th>休日</th>
                        @foreach (var header in TransferHeaders)
                        {
                            <th>
                                <div class="transfer-header">
                                    <span>@header.Label</span>
                                    <span class="small text-muted mono">@header.DateLabel</span>
                                </div>
                            </th>
                        }
                        <th>備考</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in WeekRows)
                    {
                        <tr class="@(row.IsToday ? "table-row--today" : row.IsHoliday ? "table-row--holiday" : string.Empty)">
                            <td class="mono">@row.DateLabel</td>
                            <td>@row.Weekday</td>
                            <td>@(row.IsHoliday ? "休日" : string.Empty)</td>
                            <td class="mono">@row.Schedule2</td>
                            <td class="mono">@row.Schedule9</td>
                            <td class="mono">@row.Schedule12</td>
                            <td class="mono">@row.Schedule22</td>
                            <td class="mono">@row.Schedule26</td>
                            <td>@row.NoteText</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <h2 class="home-dashboard__title">最近のアラート</h2>
    <div class="mock-card home-alert-card">
        <div class="home-alert-card__headline">
            <span class="text-danger">⚠</span>
            <strong>BJ00110: 帳票再プリント予約処理 が異常終了しました。</strong>
            <span class="text-muted small">10分前</span>
        </div>
        <div class="text-muted small home-alert-card__detail">
            エラーコード: E-402 (データベース接続タイムアウト)
        </div>
    </div>
</div>

@code {
    private static readonly string[] WeekdayLabels = ["日", "月", "火", "水", "木", "金", "土"];
    private static readonly int[] TransferDays = [2, 9, 12, 22, 26];
    private DateOnly _baseDate = DateOnly.FromDateTime(DateTime.Today);

    private string CalendarPeriodLabel => $"{_baseDate.Month}/{_baseDate.Day} - {_baseDate.AddDays(6).Month}/{_baseDate.AddDays(6).Day}";

    private IReadOnlyList<TransferHeader> TransferHeaders => TransferDays
        .Select(day =>
        {
            var date = FindNextTransferDate(day);
            return new TransferHeader($"{day}日振替", $"{date.Year}/{date.Month}/{date.Day}");
        })
        .ToList();

    private IReadOnlyList<WeekRow> WeekRows
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var rows = new List<WeekRow>(7);

            for (var offset = 0; offset < 7; offset++)
            {
                var date = _baseDate.AddDays(offset);
                var isHoliday = IsHoliday(date);
                rows.Add(new WeekRow(
                    $"{date.Month}/{date.Day}",
                    WeekdayLabels[(int)date.DayOfWeek],
                    isHoliday,
                    date == today,
                    GetTransferMark(date, isHoliday, 2),
                    GetTransferMark(date, isHoliday, 9),
                    GetTransferMark(date, isHoliday, 12),
                    GetTransferMark(date, isHoliday, 22),
                    GetTransferMark(date, isHoliday, 26),
                    isHoliday ? "休日" : string.Empty));
            }

            return rows;
        }
    }

    private static bool IsHoliday(DateOnly date)
        => date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    private static string GetTransferMark(DateOnly date, bool isHoliday, int transferDay)
        => !isHoliday && date.Day == transferDay ? "振替" : string.Empty;

    private DateOnly FindNextTransferDate(int transferDay)
    {
        for (var offset = 0; offset < 90; offset++)
        {
            var date = _baseDate.AddDays(offset);
            if (date.Day == transferDay && !IsHoliday(date))
            {
                return date;
            }
        }

        return _baseDate;
    }

    private void ShiftBaseDate(int days)
        => _baseDate = _baseDate.AddDays(days);

    private sealed record TransferHeader(string Label, string DateLabel);

    private sealed record WeekRow(
        string DateLabel,
        string Weekday,
        bool IsHoliday,
        bool IsToday,
        string Schedule2,
        string Schedule9,
        string Schedule12,
        string Schedule22,
        string Schedule26,
        string NoteText);
}
