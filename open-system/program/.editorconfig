# 統一口座再構築 コーディング規約（155-コーディング規約書）に対応するエディタ設定。
# 文字コードは UTF-8（BOM 付き）で統一する。BOM が無いと、既定コードページが異なる環境で
# 日本語の文字列リテラルが壊れることがある。
root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,razor}]
indent_size = 4
max_line_length = 120

[*.{json,csproj,slnx,props,targets,xml,config}]
indent_size = 2

[*.sql]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
